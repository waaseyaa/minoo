#!/usr/bin/env php
<?php

declare(strict_types=1);

// The in-process route loop exceeds the default 128M under the alpha.267
// repository engine; this is a dev/deploy helper, not FPM.
ini_set('memory_limit', '512M');

/**
 * Language-platform smoke test (2026-06 resurrection shape).
 * Boots the HTTP kernel against the configured database and validates the
 * critical paths: entity types, dictionary data, games, and key routes.
 *
 * Usage: bin/smoke-test
 *
 * Exit code 0 if all pass, 1 if any fail.
 */

$projectRoot = dirname(__DIR__);

require $projectRoot . '/vendor/autoload.php';

if (is_file($projectRoot . '/.env')) {
    (new Symfony\Component\Dotenv\Dotenv())->usePutenv()->load($projectRoot . '/.env');
}

$passed = 0;
$failed = 0;

function pass(string $name): void
{
    global $passed;
    fprintf(STDOUT, "[PASS] %s\n", $name);
    $passed++;
}

function fail(string $name, string $reason = ''): void
{
    global $failed;
    $msg = $reason !== '' ? sprintf('%s - %s', $name, $reason) : $name;
    fprintf(STDOUT, "[FAIL] %s\n", $msg);
    $failed++;
}

// --- 1. Kernel boot ---------------------------------------------------------

try {
    $kernel = new Waaseyaa\Foundation\Kernel\HttpKernel($projectRoot);
    $boot = new ReflectionMethod(Waaseyaa\Foundation\Kernel\AbstractKernel::class, 'boot');
    $boot->invoke($kernel);
    pass('Kernel boots');
} catch (\Throwable $e) {
    fail('Kernel boots', $e->getMessage());
    fprintf(STDOUT, "\n%d passed, %d failed\n", $passed, $failed);
    exit(1);
}

$etm = $kernel->getEntityTypeManager();

// --- 2. Entity types --------------------------------------------------------

foreach ([
    'dictionary_entry', 'example_sentence', 'word_part', 'speaker', 'contributor',
    'game_session', 'daily_challenge', 'crossword_puzzle',
    'featured_item', 'ingest_log', 'user', 'taxonomy_term',
] as $typeId) {
    if ($etm->getDefinition($typeId) !== null) {
        pass(sprintf('Entity type registered: %s', $typeId));
    } else {
        fail(sprintf('Entity type registered: %s', $typeId));
    }
}

// --- 3. Data sanity ---------------------------------------------------------

try {
    $storage = $etm->getRepository('dictionary_entry');
    $count = (int) ($storage->getQuery()->accessCheck(false)->count()->execute()[0] ?? 0);
    if ($count > 0) {
        pass(sprintf('dictionary_entry rows present (%d)', $count));
    } else {
        fail('dictionary_entry rows present', 'count is 0');
    }
} catch (\Throwable $e) {
    fail('dictionary_entry rows present', $e->getMessage());
}

// --- 4. Key routes respond --------------------------------------------------

$routes = [
    '/' => 200,
    '/language' => 200,
    '/language/search?q=makwa' => 200,
    '/games' => 200,
    '/games/shkoda' => 200,
    // Short-link shim 301s to /games/matcher (see StaticPagesRouteProvider).
    '/matcher' => 301,
    '/games/agim' => 200,
    '/games/crossword' => 200,
    '/games/journey' => 200,
    '/login' => 200,
    '/register' => 200,
    '/about' => 200,
    '/data-sovereignty' => 200,
    // Game data APIs - exercise the restored dictionary/puzzle data.
    '/api/games/shkoda/daily' => 200,
    '/api/games/shkoda/word' => 200,
    '/api/games/matcher/daily' => 200,
    '/api/games/matcher/practice' => 200,
    '/api/games/agim/start' => 200,
    // prompt without a session_token correctly rejects with 422.
    '/api/games/agim/prompt' => 422,
    '/api/games/crossword/daily' => 200,
    '/api/games/crossword/random' => 200,
    '/api/games/journey/scenes' => 200,
];

foreach ($routes as $uri => $expected) {
    try {
        // HttpKernel::handle() reads superglobals (no Request param).
        $parsed = parse_url($uri);
        $path = $parsed['path'] ?? '/';
        parse_str($parsed['query'] ?? '', $query);

        $_GET = $query;
        $_POST = [];
        $_COOKIE = [];
        $_REQUEST = $query;
        $_FILES = [];
        $_SERVER = array_merge($_SERVER, [
            'REQUEST_METHOD' => 'GET',
            'REQUEST_URI' => $uri,
            'QUERY_STRING' => $parsed['query'] ?? '',
            'PATH_INFO' => $path,
            'HTTP_HOST' => 'localhost',
            'SERVER_NAME' => 'localhost',
            'SERVER_PORT' => '80',
            'HTTPS' => '',
            'REQUEST_TIME' => time(),
            'REQUEST_TIME_FLOAT' => microtime(true),
        ]);

        $response = $kernel->handle();
        $status = $response->getStatusCode();
        $size = strlen((string) $response->getContent());
        if ($status === $expected && $size > 0) {
            pass(sprintf('GET %s -> %d (%d bytes)', $uri, $status, $size));
        } else {
            fail(sprintf('GET %s', $uri), sprintf('status %d, %d bytes (expected %d, non-empty)', $status, $size, $expected));
        }
    } catch (\Throwable $e) {
        fail(sprintf('GET %s', $uri), $e->getMessage());
    }
}

fprintf(STDOUT, "\n%d passed, %d failed\n", $passed, $failed);
exit($failed === 0 ? 0 : 1);
