# Minoo environment configuration
#
# This file is committed to version control as a template.
# Copy to .env.local for personal overrides (never committed).
#
# Precedence: process env > .env.local > .env

# ── Application ────────────────────────────────────────────────────────────────
APP_NAME=Minoo
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080

# ── Database ───────────────────────────────────────────────────────────────────
WAASEYAA_DB=./storage/waaseyaa.sqlite

# ── Authentication ─────────────────────────────────────────────────────────────
# Auto-generated by post-create-setup — do not change unless rotating the secret.
WAASEYAA_JWT_SECRET=

# Auth token-signing secret (config: auth.token_secret). Required at boot from
# Waaseyaa alpha.250 (W3-1) — the kernel throws when it is missing/empty.
AUTH_TOKEN_SECRET=

# Application secret, required by Waaseyaa alpha.250+ deployments.
# Generate a base64-encoded 32-byte value with:
#   php -r "echo 'base64:' . base64_encode(random_bytes(32)) . PHP_EOL;"
WAASEYAA_APP_SECRET=

# Dev-only: auto-authenticate as admin (never enable in production)
# WAASEYAA_DEV_FALLBACK_ACCOUNT=true

# SendGrid (email digests)
SENDGRID_API_KEY=
MAIL_FROM_ADDRESS=noreply@minoo.live
MAIL_FROM_NAME=Minoo

# NorthCloud API
NORTHCLOUD_BASE_URL=http://localhost:8050

# Crisis OG automation: batch `crisis:og-assets` + background materialization of managed `/og/crisis/*.png` files.
# HTTP still renders crisis cards dynamically without this flag; see config/crisis_incidents.php `og_generate`.
# MINOO_CRISIS_OG_AUTO=1
