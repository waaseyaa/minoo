{% extends "layouts/base.html.twig" %}

{% block title %}Minoo | {{ group.name }}{% endblock %}

{% block og_type %}article{% endblock %}

{% block content %}
  <article class="flow-lg detail">
    <nav><a class="detail__back" href="{{ lang_url('/groups') }}">{{ trans('groups.detail_back') }}</a></nav>

    <header class="detail__header flow">
      <span class="detail__badge">{{ group.type }}</span>
      <h1 class="detail__title">{{ group.name }}</h1>
    </header>

    {% if group.community_name %}
      <dl class="detail__meta-grid">
        <div class="detail__meta-item">
          <dt>{{ trans('events.host_community') }}</dt>
          <dd><a href="{{ lang_url('/communities/' ~ group.community_slug) }}">{{ group.community_name }}</a></dd>
        </div>
      </dl>
    {% endif %}

    {% if group.description %}
      <div class="detail__body flow">{{ group.description|raw }}</div>
    {% endif %}

    {% if related_events is defined and related_events|length > 0 %}
      <section class="detail__section flow">
        <h2>{{ trans('groups.related_events') }}</h2>
        <ul class="detail__related-list">
          {% for event in related_events %}
            <li><a href="{{ lang_url('/events/' ~ event.get('slug')) }}">{{ event.get('title') }}</a></li>
          {% endfor %}
        </ul>
      </section>
    {% endif %}
  </article>
{% endblock %}
