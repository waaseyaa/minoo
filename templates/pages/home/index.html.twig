{% extends "layouts/base.html.twig" %}

{% block title %}Minoo: Learn Anishinaabemowin{% endblock %}

{% block og_description %}Learn Anishinaabemowin with a community dictionary and word games built for language learners on the north shore of Lake Huron.{% endblock %}

{% block content %}

    {# === Welcome Hero === #}
    <section class="hero">
      <p class="hero__eyebrow">Aanii &middot; Welcome</p>
      <h1>A place to learn and live <em>Anishinaabemowin</em>.</h1>
      <p>
        Explore the dictionary{% if entry_count is defined and entry_count > 0 %} with {{ entry_count|number_format }} words{% endif %},
        practice with daily games, and grow with the language.
      </p>
      <div class="hero__ctas">
        <a href="{{ lang_url('/lessons') }}" class="btn btn--primary btn--lg">Start learning</a>
        <a href="{{ lang_url('/language') }}" class="btn btn--secondary btn--lg">Explore the Dictionary</a>
        <a href="{{ lang_url('/games') }}" class="btn btn--secondary btn--lg">Play Word Games</a>
      </div>
    </section>

    {# === Lessons (learn first) === #}
    <section class="sec">
      <div class="sec__head">
        <h2>Lessons</h2>
        <a href="{{ lang_url('/lessons') }}">View all &rarr;</a>
      </div>
      <div class="ds-grid">
        <a href="{{ lang_url('/lessons/the-kitchen') }}" class="card">
          <span class="card__eyebrow">Lesson 1</span>
          <h3 class="card__title">The Kitchen</h3>
          <p class="card__meta">Everyday objects in <em>Anishinaabemowin</em>, taught by Steven Bennett in his own voice.</p>
        </a>
      </div>
    </section>

    {# === Featured Items === #}
    {% if featured is defined and featured|length > 0 %}
      <section class="sec">
        <div class="sec__head">
          <h2>Featured</h2>
        </div>
        <div class="ds-grid">
          {% for item in featured %}
            <a href="{{ item.url }}" class="card card--{{ item.entity_type }}">
              <span class="card__eyebrow">{{ item.entity_type|replace({'_': ' '})|capitalize }}</span>
              <h3 class="card__title">{{ item.headline }}</h3>
              {% if item.subheadline is defined and item.subheadline %}
                <p class="card__meta">{{ item.subheadline }}</p>
              {% endif %}
            </a>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {# === Games === #}
    <section class="sec">
      <div class="sec__head">
        <h2>Games</h2>
        <a href="{{ lang_url('/games') }}">View all &rarr;</a>
      </div>
      <div class="games-hub__featured">
        {% include "components/domain/games/cards.html.twig" %}
      </div>
    </section>

    {# === Community (the second truth: language lives in the land and people) === #}
    <section class="sec">
      <div class="sec__head">
        <h2>Rooted in community</h2>
        <a href="{{ lang_url('/communities') }}">See the map &rarr;</a>
      </div>
      <p style="color: var(--text-secondary); max-width: 60ch;">Minoo grows on the north shore of Lake Huron, in Robinson-Huron Treaty territory and the care of the seven First Nations of Mamaweswen, The North Shore Tribal Council. The language lives in the land and the people who carry it.</p>
      <a href="{{ lang_url('/communities') }}" class="btn btn--secondary">Visit the communities</a>
    </section>

    {# === Call to Action === #}
    {% if account is not defined or not account.isAuthenticated() %}
      <section class="sec" style="text-align: center; padding: var(--space-xl) 0;">
        <h2>Track Your Learning</h2>
        <p style="color: var(--text-secondary); max-width: 50ch; margin: var(--space-sm) auto var(--space-md);">Start with a lesson, then create an account to keep your game streaks, save words to your own list, and pick up where you left off.</p>
        <div class="hero__ctas" style="justify-content: center;">
          <a href="{{ lang_url('/lessons') }}" class="btn btn--primary btn--lg">Start a lesson</a>
          <a href="{{ lang_url('/register') }}" class="btn btn--secondary btn--lg">Create an Account</a>
        </div>
      </section>
    {% endif %}

{% endblock %}
