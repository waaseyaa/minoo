{% extends "layouts/base.html.twig" %}

{% block title %}{%- if entry is defined and entry -%}
    Minoo | {{ entry.get('word') }}
  {%- else -%}
    Minoo | {{ trans('language.not_found') }}
  {%- endif -%}{% endblock %}

{% block content %}
  {% if entry is defined and entry %}
    <div class="flow-lg detail">
      <a href="{{ lang_url('/language') }}" class="detail__back">{{ trans('language.detail_back') }}</a>
      <div class="detail__header">
        <span class="card__badge card__badge--language">{{ entry.get('part_of_speech')|default('') }}</span>
        <h1>{{ entry.get('word') }}</h1>
      </div>
      {% if account is defined and account.isAuthenticated() and entry_id is defined and entry_id %}
        <form method="post" action="{{ lang_url('/account/words/toggle') }}" class="detail__save">
          <input type="hidden" name="_csrf_token" value="{{ csrf_token() }}">
          <input type="hidden" name="dictionary_entry_id" value="{{ entry_id }}">
          <input type="hidden" name="slug" value="{{ entry.get('slug') }}">
          <button type="submit" class="btn btn--primary">{{ is_saved|default(false) ? trans('language.saved') : trans('language.save') }}</button>
        </form>
      {% endif %}
      <div class="content-well">
        <div class="detail__body flow">
          <p>{{ entry.get('definition')|default('')|clean_definition }}</p>
          <p class="card__meta">{{ entry.get('language_code')|default('oj')|dialect_label(entry.get('attribution_source')|default('')) }}</p>
          {% if inflected_forms is defined and inflected_forms %}
            <p>{{ inflected_forms|join(' · ') }}</p>
          {% endif %}
        </div>

        {% if entry.get('audio_url')|default('') %}
          <section class="detail__section flow">
            <h2>{{ trans('language.audio_heading') }}</h2>
            <audio controls preload="none" src="{{ entry.get('audio_url') }}">{{ trans('language.audio_unsupported') }}</audio>
          </section>
        {% endif %}

        {% if examples is defined and examples|length > 0 %}
          <section class="detail__section flow">
            <h2>{{ trans('language.examples_heading') }}</h2>
            {% for ex in examples %}
              <p class="detail__example">{{ ex.ojibwe }}{% if ex.english %} <span class="card__meta">{{ ex.english }}</span>{% endif %}</p>
            {% endfor %}
          </section>
        {% endif %}

        {% if related is defined and related|length > 0 %}
          <section class="detail__section flow">
            <h2>{{ trans('language.related_heading') }}</h2>
            <p>{% for r in related %}<a href="{{ lang_url('/language/' ~ r.slug) }}">{{ r.word }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</p>
          </section>
        {% endif %}

        <footer class="attribution">
          {% if entry.get('attribution_source') %}
            <p>
              {% if entry.get('attribution_url') %}
                <a href="{{ entry.get('attribution_url') }}" rel="external noopener">{{ entry.get('attribution_source') }}</a>
              {% else %}
                {{ entry.get('attribution_source') }}
              {% endif %}
            </p>
          {% endif %}
          <p>{{ trans('language.copyright')|raw }}</p>
        </footer>
      </div>{# .content-well #}
    </div>
  {% else %}
    <div class="flow-lg">
      <h1>{{ trans('language.not_found') }}</h1>
      <p>{{ trans('language.not_found_message') }}</p>
      <p><a href="{{ lang_url('/language') }}">{{ trans('language.browse_all') }}</a></p>
    </div>
  {% endif %}
{% endblock %}

{% block structured_data %}
  {%- if entry is defined and entry -%}
  <script type="application/ld+json">{"@context":"https://schema.org","@type":"DefinedTerm","name":{{ entry.get('word')|json_encode|raw }},"description":{{ (entry.get('definition')|default('')|clean_definition)|json_encode|raw }},"inDefinedTermSet":{"@type":"DefinedTermSet","name":"Anishinaabemowin (Ojibwe) dictionary","url":"{{ site_base_url }}/language"}}</script>
  {%- else -%}
  {{ parent() }}
  {%- endif -%}
{% endblock %}
