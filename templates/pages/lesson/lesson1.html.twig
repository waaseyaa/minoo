{% extends "layouts/base.html.twig" %}

{% block title %}{{ lesson_title }} · Anishinaabemowin{% endblock %}

{% block meta_description %}{{ lesson_title }} — learn {{ total }} everyday Anishinaabemowin words with audio, taught by Steven Bennett. A free language lesson on Minoo.{% endblock %}
{% block og_description %}{{ lesson_title }} — {{ total }} Anishinaabemowin words with audio, taught by Steven Bennett. Free to learn on Minoo.{% endblock %}

{% block structured_data %}
  {{ parent() }}
  <script type="application/ld+json">{"@context":"https://schema.org","@type":["Course","LearningResource"],"name":{{ lesson_title|json_encode|raw }},"description":{{ (lesson_title ~ ': ' ~ total ~ ' everyday Anishinaabemowin words with audio, taught by Steven Bennett.')|json_encode|raw }},"url":"{{ site_base_url }}{{ lang_url('/lessons/' ~ (lesson_slug|default(''))) }}","inLanguage":["oj","en"],"isAccessibleForFree":true,"educationalLevel":"beginner","learningResourceType":"lesson","teaches":"Anishinaabemowin vocabulary","provider":{"@type":"Organization","name":"Minoo","url":"{{ site_base_url }}"}}</script>
  {% include "components/seo/breadcrumb.html.twig" with { crumbs: [{ name: 'Lessons', url: '/lessons' }, { name: lesson_title, url: '/lessons/' ~ (lesson_slug|default('')) }] } %}
{% endblock %}

{% block content %}
<div class="lesson-page" id="lesson">
  <header class="lesson-hero">
    <p class="lesson-hero__eyebrow"><a href="{{ lang_url('/lessons') }}">&larr; Lessons</a></p>
    <p class="lesson-hero__eyebrow">Lesson 1 of the Anishinaabemowin corpus</p>
    <h1>The kitchen, in <em>Anishinaabemowin</em></h1>
    <p class="lesson-hero__lede">
      Sixteen everyday objects, taught by Steven Bennett on his Facebook reels.
      Press play on any card to watch him teach it. Turn on Practice to hide the
      English and test yourself, then tap a card to reveal it.
    </p>
    <p class="lesson-hero__credit">
      Taught by <a href="{{ steven_url }}" target="_blank" rel="noopener">Steven Bennett</a>.
      Every card is one of his reels, in his voice.
    </p>
  </header>

  <div class="lesson-toolbar">
    <label><input type="checkbox" id="lesson-practice"> Practice mode (hide English)</label>
    <label><input type="checkbox" id="lesson-autoplay" checked> Autoplay audio on tap</label>
    <span class="lesson-toolbar__stat"><span id="lesson-known-count">0</span> of {{ total }} marked known</span>
  </div>

  {% for group in groups %}
    <h2 class="lesson-group__label">{{ group.label }}</h2>
    <div class="lesson-grid">
      {% for item in group.items %}
        <article class="lesson-card{% if item.video %} lesson-card--video{% endif %}" data-id="{{ item.id }}">
          {% if item.video %}
            <video class="lesson-card__video" controls playsinline preload="none" loading="lazy"
                   poster="{{ item.thumb }}" src="{{ item.video }}"
                   aria-label="Steven Bennett teaching {{ item.english }}"></video>
          {% else %}
            <img class="lesson-card__thumb" loading="lazy" src="{{ item.thumb }}" alt="">
          {% endif %}
          <div class="lesson-card__body">
            <div class="lesson-card__oji">{{ item.ojibwe }}</div>
            <div class="lesson-card__english">{{ item.english }}</div>
            <div class="lesson-card__actions">
              {% if not item.video %}
                <button class="lesson-card__play" type="button" aria-label="Play Steven's audio">Listen</button>
              {% endif %}
              <button class="lesson-card__known" type="button" aria-label="Mark known" title="Mark known">&check;</button>
            </div>
            {% if item.source_url %}
              <a class="lesson-card__source" href="{{ item.source_url }}" target="_blank" rel="noopener">Source reel</a>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  {% endfor %}

  <footer class="lesson-footer">
    <p>Source. Each card is a real reel from <a href="{{ steven_url }}" target="_blank" rel="noopener">Steven Bennett's Facebook</a>. The audio is his unmodified voice.</p>
    <p>Orthography. Spellings are transcribed from the whiteboards exactly as written. Steven's local spelling may differ from standard double-vowel; we record what the Elder writes, we do not normalize it.</p>
    <p>Consent. Taught by <a href="{{ steven_url }}" target="_blank" rel="noopener">Steven Bennett</a> and shared with his consent &mdash; for public display, publication, search, and language learning. Miigwech.</p>
  </footer>
</div>

<script src="/js/lesson.js?v=2" defer></script>
{% endblock %}
