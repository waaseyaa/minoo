{% extends "layouts/base.html.twig" %}

{% block title %}Minoo | Communities{% endblock %}
{% block meta_description %}The seven First Nations of Mamaweswen, The North Shore Tribal Council, on the north shore of Lake Huron in Robinson-Huron Treaty territory.{% endblock %}

{% block head %}
  <link rel="stylesheet" href="/css/leaflet.css">
{% endblock %}

{% block content %}
  <div class="flow-lg content-max">
    <header class="listing-hero">
      <h1>Communities</h1>
      <p>The seven First Nations of <a href="https://mamaweswen.com/" rel="external noopener">Mamaweswen, The North Shore Tribal Council</a>, on the north shore of Lake Huron in Robinson-Huron Treaty territory, anchored at Sagamok Anishnawbek.</p>
    </header>

    <div id="community-map" class="community-map" role="application" aria-label="Interactive map of the seven Mamaweswen First Nations on the north shore of Lake Huron. The nations are also listed as links below."></div>
    <noscript><p class="card__meta">The map needs JavaScript. The seven nations are listed below.</p></noscript>

    <section class="flow">
      <h2>The seven nations</h2>
      <div class="card-grid">
        {% for nation in nations %}
          <a href="{{ lang_url('/communities/' ~ nation.slug) }}" class="card">
            <h3 class="card__title">{{ nation.name }}{% if nation.anchor %} <span class="card__badge card__badge--language">Anchor</span>{% endif %}</h3>
            <p class="card__meta">{{ nation.reserve }} · {{ nation.treaty }}</p>
          </a>
        {% endfor %}
      </div>
    </section>

    <p class="card__meta">Community locations and leadership are drawn from public records (Indigenous Services Canada First Nation Profiles). Listings of individual community members are not published here.</p>
  </div>
{% endblock %}

{% block scripts %}
  <script type="application/json" id="community-markers">{{ map_markers|raw }}</script>
  <script src="/js/leaflet.js"></script>
  <script src="/js/community-map.js?v=1"></script>
{% endblock %}
