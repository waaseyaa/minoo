{# Required: word
   Optional: part_of_speech, url, definition, example, tags, language_code, attribution_source #}
<article class="card card--language">
  {% if part_of_speech is defined and part_of_speech %}
    <span class="card__badge card__badge--language">{{ part_of_speech }}</span>
  {% endif %}
  <h3 class="card__title">
    {%- if url is defined and url -%}
      <a href="{{ url }}">{{ word }}</a>
    {%- else -%}
      {{ word }}
    {%- endif -%}
  </h3>
  {% set def = definition is defined ? definition|clean_definition : '' %}
  {% if def %}
    <p class="card__body">{{ def }}</p>
  {% endif %}
  {% if example is defined and example %}
    <p class="card__body"><em>{{ example }}</em></p>
  {% endif %}
  {% if tags is defined and tags %}
    <div>
      {% for tag in tags %}
        <span class="card__tag">{{ tag }}</span>
      {% endfor %}
    </div>
  {% endif %}
  <p class="card__meta">{{ (language_code|default('oj'))|dialect_label(attribution_source|default('')) }}</p>
</article>
