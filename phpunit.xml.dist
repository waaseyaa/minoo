<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="MinooUnit">
            <directory>tests/App/Unit</directory>
        </testsuite>
        <testsuite name="MinooIntegration">
            <directory>tests/App/Integration</directory>
        </testsuite>
    </testsuites>
    <php>
        <!-- Explicit test environment: without it the framework treats the
             runtime as 'production' on CI (no .env) and alpha.250+ auth boot
             throws on the missing token secret. -->
        <env name="APP_ENV" value="testing"/>
    </php>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
</phpunit>
